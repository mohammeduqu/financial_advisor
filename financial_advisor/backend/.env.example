# Copy to .env in this directory. Restart Flask after editing these settings.
# Keep API keys here on the backend, never in Flutter or source control.
OPENAI_API_KEY=
# A model supporting image input + Structured Outputs in the Responses API.
# Change this model ID to switch models; no Flutter changes are needed.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=8192
OPENAI_IMAGE_DETAIL=high

# Shopping searches use a separate SerpAPI key.
SERPAPI_KEY=
SERPAPI_LANGUAGE=en
SERPAPI_TIMEOUT_SECONDS=20
PRICE_CACHE_TTL_SECONDS=43200
PRICE_CACHE_PATH=cache/searches.sqlite3
RECOMMENDATION_MAX_SEARCHES=8
RECOMMENDATION_MIN_MATCH_SCORE=0.85
RECOMMENDATION_MIN_SAVING_AMOUNT=2
RECOMMENDATION_MIN_SAVING_PERCENTAGE=5
RECOMMENDATION_GOOD_SAVING_PERCENTAGE=10
RECOMMENDATION_EXCELLENT_SAVING_PERCENTAGE=20
# Optional exact extra browser page origins. Loopback ports work automatically.
NUMO_ALLOWED_ORIGINS=
